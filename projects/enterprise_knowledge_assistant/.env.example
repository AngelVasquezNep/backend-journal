# Copy privately to .env. Replace every CHANGE_ME value with a different random secret.
# Python 3.14: Identity. Python 3.12: Knowledge and Chat. Frontend package manager: pnpm.
TASKIFY_ENV=development
PUBLIC_ORIGIN=http://localhost:8080
POSTGRES_PASSWORD=CHANGE_ME
IDENTITY_DB_PASSWORD=CHANGE_ME
IDENTITY_MIGRATION_PASSWORD=CHANGE_ME
KNOWLEDGE_DB_PASSWORD=CHANGE_ME
KNOWLEDGE_MIGRATION_PASSWORD=CHANGE_ME
CHAT_DB_PASSWORD=CHANGE_ME
CHAT_MIGRATION_PASSWORD=CHANGE_ME
SESSION_HMAC_KEY=CHANGE_ME
KNOWLEDGE_API_CREDENTIAL=CHANGE_ME
KNOWLEDGE_WORKER_CREDENTIAL=CHANGE_ME
CHAT_API_CREDENTIAL=CHANGE_ME
CHAT_WORKER_CREDENTIAL=CHANGE_ME
# Stub mode is for deterministic development only; production must use openai.
AI_MODE=stub
# Backend only. Supply the key through your secret mechanism, never a VITE_ variable.
OPENAI_API_KEY=
# Required in openai mode. No chat-model default or legacy alias is supported.
OPEN_AI_MODEL=
# Independent Knowledge embedding space; changing the chat model does not re-embed.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
PIPELINE_VERSION=pipeline-v1
# Optional backend LangSmith tracing. This is a separate key from OPENAI_API_KEY.
# Compose keeps inputs/outputs hidden and passes these settings only to Chat/Knowledge.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=taskify-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required for API keys scoped to multiple workspaces; otherwise leave blank.
LANGSMITH_WORKSPACE_ID=
# For host execution, export these too; Compose sets them automatically.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# Containers use private DNS over the isolated Compose network. Use TLS outside loopback.
# Databases have separate migration/runtime identities; files mount in Knowledge only.
